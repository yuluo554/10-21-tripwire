# 源码包白名单：让 sdist 自足——解包后 README 的每条命令都能真敲
# 判据 = "解包树里有没有这条命令要读的文件"（README 的开发一节会跑 tools/ 门与 tests/）
include README.md
include LICENSE
include AGENTS.md
include MANIFEST.in
include data/README.md
recursive-include pipelines *.json
recursive-include fixtures/golden *
recursive-include docs *.md
recursive-include plan *.md
recursive-include tools *.py
recursive-include tests *.py
prune .github
global-exclude *.py[cod] __pycache__ .DS_Store .mypy_cache .pytest_cache .ruff_cache
