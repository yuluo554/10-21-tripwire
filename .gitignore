dmypy.json
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# 构建/打包
*.spec
!packaging/*.spec

# 运行时产物：审计快照与报告（可能含真实数据，禁入库）
runs/
*.xlsx
*.xls
*.xlsm
~$*.xlsx
~$*.xls

# 夹具临时输出（`gen-fixture` 每次运行的落点）
# 注意：入库的金样本在 fixtures/golden/，不受此规则影响——放行的交付物不是构建垃圾
fixtures/out/

# 发布产物
release/
*.zip
*.tar.gz
!docs/**/*.zip

# 编辑器与系统
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 本地私有
_private/
*.local
*.log

# 门与构建的临时落点（变异验证、wheel 试构建）
.tmp/

# 迭代交接物（诊断 / 路线 / 提示词 / 执行记录）：非交付面，且必然记录本机路径
update/
